#!/bin/bash
set -euo pipefail

# Check for dry-run flag (-n or --dry-run)
DRY_RUN=""
if [[ "${1:-}" == "--dry-run" || "${1:-}" == "-n" ]]; then
  DRY_RUN="-n"
  echo ">>> RUNNING IN DRY-RUN MODE (No files will be changed) <<<"
  echo
fi

rsync -rlvzc $DRY_RUN --delete --no-p --no-t \
  --rsync-path="sudo rsync" \
  --usermap=*:www-data \
  --groupmap=*:www-data \
  --chmod=D2775,F664 \
  --exclude="/vendor/***" \
  --exclude="/.settings/" \
  --exclude="/.project" \
  --exclude="/.buildpath" \
  --exclude="/.git/***" \
  --exclude="/tests/Api/files/***" \
  --exclude="/tests/Api/fixtures/***" \
  --exclude="/tests/Api/fixtures-prev/***" \
  --include="/composer.json" \
  --include="/composer.lock" \
  --include="/phpunit*.xml" \
  --include="/phpstan.neon" \
  --include="*/" \
  --include="*.php" \
  --include="*.sh" \
  --include="*.sql" \
  --include="*.example" \
  --exclude="*" \
  ./ www-data@kam-motion.com:/var/www/html/greenjeans/

echo
echo "Upload time: $SECONDS seconds."
echo
date
