{
  "name": "shmuelakam/greenjeans",
  "description": "PHP SDK and persistence layer for Geni.com API",
  "type": "library",
  "license": "MIT",
  "homepage": "https://github.com/shmuelakam/greenjeans",
  "prefer-stable": true,
  "authors": [
    {
      "name": "Shmuel A. Kam",
      "role": "Owner",
      "email": "shmuel@kam-motion.com"
    }
  ],
  "keywords": [
    "geni",
    "geni-api",
    "geni-sdk",
    "persistence"
  ],
  "require": {
    "php": "^8.1"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.0",
    "phpstan/phpstan-phpunit": "^2.0",
    "phpunit/phpunit": "^10.5",
    "friendsofphp/php-cs-fixer": "^3.0"
  },
  "autoload": {
    "psr-4": {
      "ShmuelAKam\\Greenjeans\\": "src/"
    },
    "files": [
        "src/Api/Core/Debug_OUT.php"
    ]        
  },
  "autoload-dev": {
    "psr-4": {
      "ShmuelAKam\\Greenjeans\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test:api": "vendor/bin/phpunit -c phpunit.api.xml",
    "test:db": "vendor/bin/phpunit -c phpunit.persistence.xml",
    "test": [
      "@test:api",
      "@test:db"
    ],
    "phpstan": "vendor/bin/phpstan analyse"
  }
}
