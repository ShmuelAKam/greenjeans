parameters:
    level: 6
    paths:
        - src
        - tests

    excludePaths:
        - src/Temp.php

    bootstrapFiles:
        - vendor/autoload.php

    scanFiles:
        - src/Api/Core/Debug_OUT.php
        - tests/Api/GlobalSetup.php 
        - tests/Persistence/GlobalSetup.php 

includes:
    - vendor/phpstan/phpstan-phpunit/extension.neon

